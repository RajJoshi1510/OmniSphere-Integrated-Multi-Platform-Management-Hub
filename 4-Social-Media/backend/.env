# ConnectVerse (Social Media) - Server Environment Configuration
# Simple English Comment: Server runs on port 5000. We use local MongoDB. Without Cloudinary, image uploads won't work.
NODE_ENV=development
PORT=5000

# MongoDB local connection
MONGO_URI=mongodb://localhost:27017/connectverse

# JWT secret for login tokens - keep this private
JWT_SECRET=your_local_dev_jwt_secret_connectverse_abc456
JWT_EXPIRES_IN=7d

# CORS - which frontend URL is allowed to talk to this backend
CLIENT_URL=http://localhost:5177

# Cloudinary (optional in local dev - image upload won't work without real keys)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin account auto-created when server boots (change these for security)
ADMIN_EMAIL=admin@connectverse.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

