# ShopNow (E-Commerce) - Server Environment Configuration
# Simple English Comment: Server runs on port 5002, connects to local MongoDB
PORT=5002

# MongoDB local connection - eshop is the database name
MONGODB_URI=mongodb://localhost:27017/shopnow

# Pusher keys - set to mock so the app runs without real Pusher account
PUSHER_APP_ID=mock
VITE_PUSHER_KEY=mock
PUSHER_SECRET=mock
VITE_PUSHER_CLUSTER=ap2

