# OmniDrive (Car Rental) - Server Environment Configuration
# Simple English Comment: Backend runs on port 4001. We use local MongoDB. No real 3rd party keys needed to run locally.
PORT=4001

# MongoDB local connection - Change this if you have MongoDB running somewhere else
MONGODB_URI=mongodb://localhost:27017

# JWT Secret used to sign login tokens - keep this secret
JWT_SECRET=your_local_dev_jwt_secret_omnidrive_123

# ImageKit keys (optional in local dev - image upload will not work without real keys)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Razorpay keys (optional in local dev - payments will not work without real keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OpenAI key (optional in local dev - AI chat will not work without real keys)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

